{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "matchDepTypes": ["dependencies"],
      "groupName": "production dependencies",
      "automerge": true
    }
  ]
}
