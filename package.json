{
  "name": "@thomas/forgejo-semantic-release",
  "version": "0.0.0-development",
  "description": "semantic-release plugin for Forgejo",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "eslint src test .forgejo",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "release:dry": "semantic-release --dry-run",
    "release:debug": "DEBUG=forgejo-semantic-release:* semantic-release --dry-run"
  },
  "keywords": [
    "semantic-release",
    "forgejo",
    "gitea",
    "release",
    "publish",
    "version"
  ],
  "repository": {
    "type": "git",
    "url": "https://forgejo.peuss.de/thomas/forgejo-semantic-release.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://forgejo.peuss.de/api/packages/thomas/npm/"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "peerDependencies": {
    "semantic-release": ">=20.0.0"
  },
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "aggregate-error": "^5.0.0",
    "debug": "^4.3.4",
    "globby": "^16.0.0",
    "lodash-es": "4.18.1",
    "mime-types": "^3.0.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@types/debug": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.0",
    "@types/node": "^25.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.1.38",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-yml": "^3.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.22.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0",
    "undici": "^7.20.0",
    "vitest": "^4.0.18"
  }
}
