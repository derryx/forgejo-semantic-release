{
  "name": "forgejo-semantic-release",
  "version": "0.0.0-development",
  "description": "semantic-release plugin for Forgejo",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write .",
    "prepublishOnly": "npm run build",
    "release:dry": "semantic-release --dry-run",
    "release:debug": "DEBUG=forgejo-semantic-release:* semantic-release --dry-run"
  },
  "keywords": [
    "semantic-release",
    "forgejo",
    "gitea",
    "release",
    "publish",
    "version"
  ],
  "repository": {
    "type": "git",
    "url": "https://forgejo.peuss.de/thomas/forgejo-semantic-release.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "semantic-release": ">=20.0.0"
  },
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "aggregate-error": "^5.0.0",
    "debug": "^4.3.4",
    "globby": "^14.0.0",
    "lodash-es": "^4.17.21",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/debug": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "semantic-release": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "undici": "^7.18.2",
    "vitest": "^1.0.0"
  }
}
